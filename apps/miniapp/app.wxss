page{background:#f0f2f5;color:#303133;font-size:26rpx;--button-primary-background-color:#409EFF;--button-primary-border-color:#409EFF;--tag-primary-color:#409EFF}
.page{padding:16rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}.card{background:#fff;border-radius:8rpx;box-shadow:0 2rpx 6rpx rgba(0,0,0,.04);padding:16rpx;margin-bottom:12rpx}.title{font-size:28rpx;font-weight:600;margin:16rpx 0}.description{font-size:22rpx;color:#909399;line-height:1.6}.number{font-size:30rpx;font-weight:600}.row{display:flex;align-items:center;justify-content:space-between;gap:8rpx}.ellipsis{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;min-width:0}.summary{margin-top:16rpx;line-height:1.8}.notice{padding:16rpx;font-size:22rpx;color:#909399}.error{color:#f56c6c;word-break:break-all;margin:16rpx 0}.loading{text-align:center;padding:24rpx}.actions{margin-top:16rpx}.safe-bottom{padding-bottom:constant(safe-area-inset-bottom);padding-bottom:env(safe-area-inset-bottom)}
